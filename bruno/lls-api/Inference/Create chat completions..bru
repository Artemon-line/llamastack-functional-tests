meta {
  name: Create chat completions.
  type: http
  seq: 1
  tags: [
    Inference
  ]
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: inherit
}

body:json {
  {
    "model": "",
    "messages": [],
    "frequency_penalty": "",
