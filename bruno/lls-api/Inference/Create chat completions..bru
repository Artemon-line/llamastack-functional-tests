    "max_tokens": "",
    "n": "",
    "parallel_tool_calls": "",
    "presence_penalty": "",
    "response_format": "",
    "seed": "",
    "stop": "",
    "stream": "",
    "stream_options": "",
    "temperature": "",
    "tool_choice": "",
    "tools": "",
    "top_logprobs": "",
    "top_p": "",
    "user": "",
    "safety_identifier": "",
    "service_tier": "",
    "reasoning_effort": "",
    "prompt_cache_key": ""
  }
}
