meta {
  name: List Providers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/providers
  body: none
  auth: inherit
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });
  test("Response is array or object", function() {
    const body = res.getBody();
    expect(body).to.be.ok;
  });
}
