meta {
  name: Get File
  type: http
  seq: 3
}

http {
  method: GET
  url: {{base_url}}/v1/files/{{file_id}}
  body: none
  auth: none
}

script: post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });
  test("Response has id matching file_id", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.id).to.eql(bru.getEnvVar("file_id"));
  });
}
