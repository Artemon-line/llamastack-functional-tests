meta {
  name: Get Vector Store
  type: http
  seq: 3
}

http {
  method: GET
  url: {{base_url}}/v1/vector_stores/{{vector_store_id}}
  body: none
  auth: none
}

script: post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });
  test("Response id matches vector_store_id", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.id).to.eql(bru.getEnvVar("vector_store_id"));
  });
}
