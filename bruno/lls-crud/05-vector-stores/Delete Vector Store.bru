meta {
  name: Delete Vector Store
  type: http
  seq: 4
}

http {
  method: DELETE
  url: {{base_url}}/v1/vector_stores/{{vector_store_id}}
  body: none
  auth: none
}

script: post-response {
  test("Status is 200 or 204", function() {
    const status = res.getStatus();
    expect([200, 204]).to.include(status);
  });
}
