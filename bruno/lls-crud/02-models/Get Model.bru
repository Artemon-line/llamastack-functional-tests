meta {
  name: Get Model
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/models/{{model}}
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Returns correct model", function() {
    const body = res.getBody();
    expect(body).to.have.property("identifier");
    expect(body).to.have.property("provider_id");
    expect(body).to.have.property("model_type");
  });
}
