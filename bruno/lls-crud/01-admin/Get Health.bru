meta {
  name: Get Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/health
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Has status OK", function() {
    const body = res.getBody();
    expect(body).to.have.property("status");
    expect(body.status).to.eql("OK");
  });
}
