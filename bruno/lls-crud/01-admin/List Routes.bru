meta {
  name: List Routes
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/inspect/routes
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Has data array with routes", function() {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data).to.be.an("array");
    expect(body.data.length).to.be.greaterThan(0);
  });

  test("Route has required fields", function() {
    const route = res.getBody().data[0];
    expect(route).to.have.property("route");
    expect(route).to.have.property("method");
  });
}
