meta {
  name: Create Chat Completion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": "Say hello in one word."
      }
    ],
    "max_tokens": 32,
    "stream": false
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Has choices array", function() {
    const body = res.getBody();
    expect(body).to.have.property("choices");
    expect(body.choices).to.be.an("array");
    expect(body.choices.length).to.be.greaterThan(0);
  });

  test("Choice has message with content", function() {
    const choice = res.getBody().choices[0];
    expect(choice).to.have.property("message");
    expect(choice.message).to.have.property("content");
    expect(choice.message.content).to.be.a("string");
  });
}
