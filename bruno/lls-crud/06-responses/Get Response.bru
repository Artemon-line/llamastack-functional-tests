meta {
  name: Get Response
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/responses/{{response_id}}
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Returns response with correct ID", function() {
    const body = res.getBody();
    expect(body).to.have.property("id");
  });
}
