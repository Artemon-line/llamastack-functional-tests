meta {
  name: List Responses
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/responses
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });

  test("Has data array", function() {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data).to.be.an("array");
  });
}
